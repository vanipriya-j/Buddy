# Local use. `npm run dev` starts a Postgres database in data/pglite. No Supabase account is required.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54329/postgres"

# Supabase. Replace both URLs with the values from Project Settings → Database.
# DATABASE_URL is the transaction pooler (port 6543) and must end with ?pgbouncer=true
# DIRECT_URL is the session pooler or direct connection (port 5432), used for migrations.
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
# SUPABASE_URL="https://[project-ref].supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="service-role-key"
# SUPABASE_STORAGE_BUCKET="materials"

SESSION_SECRET="replace-with-a-long-random-string"
NEXT_TELEMETRY_DISABLED=1
